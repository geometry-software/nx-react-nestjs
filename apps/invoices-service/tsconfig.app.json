{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist-types",
    "types": ["node"],
    "rootDir": "src",
    "tsBuildInfoFile": "dist-types/tsconfig.app.tsbuildinfo",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "target": "es2021",
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["out-tsc", "dist", "dist-types", "src/**/*.spec.ts"],
  "references": [{ "path": "../../packages/backend-utils/tsconfig.lib.json" }]
}
