{
  "name": "nx-react-nestjs",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "build": "npm exec -- nx run-many -t build",
    "lint": "npm exec -- nx run-many -t lint",
    "test": "npm exec -- nx run-many -t test",
    "typecheck": "npm exec -- nx run-many -t typecheck",
    "dev:frontend": "npm exec -- nx serve frontend",
    "dev:auth": "npm exec -- nx serve auth-service",
    "dev:products": "npm exec -- nx serve products-service",
    "dev:users": "npm exec -- nx serve users-service",
    "dev:shipping": "npm exec -- nx serve shipping-service",
    "dev:invoices": "npm exec -- nx serve invoices-service",
    "dev": "npm exec -- nx run-many -t serve --projects=frontend,auth-service,products-service,users-service,shipping-service,invoices-service --parallel=6",
    "start": "node scripts/start-open.mjs",
    "seed": "sh scripts/seed.sh",
    "graph": "npm exec -- nx graph"
  },
  "private": true,
  "engines": {
    "node": "^22.22.3 || >=24.15.0"
  },
  "devDependencies": {
    "@babel/core": "^7.14.5",
